[alias]
  cam = !git add --all && git commit -m
  cm = commit -m
  d = diff
  dc = diff --cached
  fa = "!f() { sha=$(git rev-parse --verify \"$1^{commit}\") && git add --all && git commit --fixup \"$sha\" && git -c sequence.editor=: rebase -i --autosquash --rebase-merges \"$sha~\"; }; f"
  l = log --pretty=custom --graph
  pf = push --force-with-lease
  s = status --short --branch
  sc = log --pretty=custom -S
  sm = log --pretty=custom --grep
  u = commit --amend --no-edit --date=now
  ua = !git add --all && git commit --amend --no-edit --date=now
  uap = !git add --all && git commit --amend --no-edit --date=now && git push --force-with-lease
  undo = reset --soft HEAD~

[apply]
  whitespace = fix

[branch]
  sort = -committerdate

[commit]
  gpgsign = true
  verbose = true

[core]
  autocrlf = input
  excludesFile = {{ joinPath .chezmoi.homeDir ".config/git/ignore" }}
  trustctime = false

[credential]
{{- if eq .chezmoi.os "darwin" }}
  helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
  helper = wincred
{{- else }}
  helper = cache --timeout=3600
{{- end }}
{{- if and (eq .chezmoi.os "darwin") (stat "/opt/homebrew/bin/gh") }}

[credential "https://github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}

[diff]
  algorithm = histogram
  colorMoved = default
  renames = copies

[fetch]
  prune = true
  pruneTags = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" }}
{{- if and (eq .chezmoi.os "darwin") (stat "/Applications/1Password.app") }}
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}

[help]
  autocorrect = prompt

[init]
  defaultBranch = main

[merge]
  conflictStyle = zdiff3
  log = true

[pretty]
  custom = "%C(magenta)%h%C(red)%d %C(yellow)%ar %C(green)%s %C(yellow)(%an)"

[pull]
  rebase = merges

[push]
  autoSetupRemote = true
  followTags = true
  useForceIfIncludes = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  autoUpdate = true
  enabled = true

[safe]
  bareRepository = explicit

[tag]
  sort = version:refname

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[user]
  email = dev@ppmathis.com
  name = Pascal Mathis
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJBs2lSgwcl9pjg+aEFbCVzjsKtFk4KqQzMhSGXcVmws

# This must always be at the end of the file to properly support local overrides
[include]
  path = {{ joinPath .chezmoi.homeDir ".config/git/local" }}
