{{- $config := fromToml (includeTemplate "starship.toml" .) -}}
{{- if lookPath "nctt" -}}
{{-   $nctt := dict "command" "nctt status --shell" "format" "[nctt:](bold) $output " -}}
{{-   $config = mergeOverwrite $config (dict "custom" (dict "nctt" $nctt)) -}}
{{- end -}}
{{- if lookPath "starship" -}}
{{-   $preset := fromToml (output "starship" "preset" "nerd-font-symbols") -}}
{{-   $config = mergeOverwrite $preset $config -}}
{{- end -}}
{{ toToml $config }}
